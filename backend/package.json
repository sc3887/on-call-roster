{
  "name": "@roster/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test prisma",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.cjs generate",
    "db:migrate": "node scripts/prisma.cjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:dev": "node scripts/prisma.cjs migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
