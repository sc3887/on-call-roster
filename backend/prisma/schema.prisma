generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  role         String   @default("USER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      SupportTicket[] @relation("TicketRequester")
  messages     TicketMessage[]
  teamMember   TeamMember?
}

model SupportTicket {
  id          String          @id @default(cuid())
  subject     String          @db.VarChar(120)
  status      String          @default("OPEN")
  requesterId String
  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  messages    TicketMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, updatedAt])
  @@index([requesterId, updatedAt])
}

model TicketMessage {
  id        String        @id @default(cuid())
  body      String        @db.VarChar(4000)
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  role      String
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    Shift[]
}

model Shift {
  id           String     @id @default(cuid())
  date         DateTime   @db.Date
  notes        String?    @db.VarChar(500)
  memberId     String
  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([memberId, date])
  @@index([date, id])
}
